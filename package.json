{
  "name": "open-multicam",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.benchmarks.json",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:native": "bun scripts/check-repository.mjs --native-tests",
    "test:e2e:sim": "bun e2e/simulator/runner.ts",
    "test:e2e:device": "bun e2e/device/runner.ts",
    "check:repository": "bun scripts/check-repository.mjs",
    "doctor": "bunx expo-doctor",
    "validate": "bun run check:repository && bun run lint && bun run typecheck && bun run test:coverage && bun run doctor",
    "test:storekit": "bun scripts/run-storekit-tests.mjs",
    "benchmark": "bun scripts/benchmark.mjs",
    "benchmark:stress": "bun scripts/benchmark.mjs run --iterations 100000"
  },
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.3",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tuft-telemetry": "0.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  }
}
