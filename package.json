{
  "name": "open-multicam",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:native": "bun scripts/check-repository.mjs --native-tests",
    "test:e2e:sim": "E2E_TELEMETRY_DISABLED=1 bunx --no-install e2e run",
    "test:e2e:device": "E2E_TELEMETRY_DISABLED=1 bunx --no-install e2e run --config e2e.hardware.config.ts",
    "check:repository": "bun scripts/check-repository.mjs",
    "doctor": "bunx expo-doctor",
    "validate": "bun run check:repository && bun run lint && bun run typecheck && bun run test:coverage && bun run doctor",
    "test:storekit": "bun scripts/run-storekit-tests.mjs",
    "test:e2e:list": "E2E_TELEMETRY_DISABLED=1 bunx --no-install e2e list",
    "typecheck:e2e": "tsc --noEmit --project e2e/tsconfig.json",
    "build:e2e:sim": "bun scripts/build-e2e-simulator.ts",
    "prepare:e2e:device": "bun scripts/prepare-e2e-hardware.ts",
    "build:e2e:device": "bun scripts/build-e2e-hardware.ts"
  },
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "expo": "~57.0.26",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-media-library": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-updates": "~57.0.24",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "tuft-telemetry": "0.1.0"
  },
  "devDependencies": {
    "@e2e-dev/mobile": "0.9.2",
    "@testing-library/react-native": "^13",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "e2e": "0.17.0",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
