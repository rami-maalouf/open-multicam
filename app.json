{
  "expo": {
    "name": "OpenMulticam",
    "slug": "open-multicam",
    "description": "Private, native multicamera video recording.",
    "version": "1.0.1",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "openmulticam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ramimaalouf.openmulticam",
      "supportsTablet": false,
      "deploymentTarget": "18.6",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "OpenMulticam uses your iPhone cameras to preview and record the camera views you select.",
        "NSMicrophoneUsageDescription": "OpenMulticam uses the selected microphone to record sound with your videos.",
        "NSPhotoLibraryAddUsageDescription": "OpenMulticam saves videos to Photos only when you choose Save to Photos."
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#05090b",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#030607"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e272538-a33a-4184-9bd5-7b28712854b7"
      }
    },
    "owner": "ramimaalouf",
    "android": {
      "package": "com.ramimaalouf.openmulticam",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#06151a"
      }
    }
  }
}
